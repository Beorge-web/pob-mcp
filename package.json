{
  "name": "pob-engine-mcp",
  "version": "0.1.0",
  "description": "PoE1 build editing over MCP with unchanged Path of Building calculations",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && npm run test:engine",
    "test:engine": "node --test tests/engine/protocol.test.mjs",
    "test:ci": "npm test",
    "test:live": "npm run build && node tests/engine/live.mjs",
    "test:upstream": "jest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bottleneck": "^2.19.5",
    "chokidar": "^4.0.3",
    "fast-xml-parser": "^5.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  },
  "private": true
}
